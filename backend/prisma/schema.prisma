generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  passwordHash  String
  createdAt     DateTime     @default(now())
  attachments   Attachment[]
  comments      Comment[]
  favorites     Favorite[]
  memberships   Membership[]
  assignedTasks Task[] @relation("AssignedTasks")
  ownedProjects Project[]    @relation("OwnerProjects")
}

model Project {
  id          String          @id @default(uuid())
  shortId     String          @unique //clean url didnt realize it would be the 32 char uuid
  name        String
  description String
  ownerId     String
  //cardPhoto   String?         @default() // Placeholder for future card photo URL
  createdAt   DateTime        @default(now()) 

  //relations
  memberships Membership[]
  invites     PendingInvite[]
  owner       User            @relation("OwnerProjects", fields: [ownerId], references: [id])
  tasks       Task[]
  favorites   Favorite[]

  @@index([ownerId], map: "Project_ownerId_fkey")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  assigneeId  String?
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  status      TaskStatus   @default(TODO)
  description String
  projectId   String
  createdAt   DateTime     @default(now())
  attachments Attachment[]
  comments    Comment[]
  project     Project      @relation(fields: [projectId], references: [id])

  @@index([projectId], map: "Task_projectId_fkey")
  @@index([assigneeId], map: "Task_assigneeId_fkey")

}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId], map: "Membership_projectId_fkey")
}

model PendingInvite {
  id        String   @id @default(uuid())
  email     String
  projectId String
  role      Role @default(MEMBER)
  token     String   @unique
  status    InviteStatus @default(PENDING)
  createdAt DateTime @default(now())
  expiresAt DateTime
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([email])
  @@index([projectId], map: "PendingInvite_projectId_fkey")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId], map: "Favorite_projectId_fkey")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId], map: "Comment_taskId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
}

model Attachment {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  taskId     String
  uploadedBy String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id])
  user       User     @relation(fields: [uploadedBy], references: [id])

  @@index([taskId], map: "Attachment_taskId_fkey")
  @@index([uploadedBy], map: "Attachment_uploadedBy_fkey")
}
